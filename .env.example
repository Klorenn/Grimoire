# Grimoire — Environment Variables
# Copy this file to .env and fill in your values.

# Lighthouse Storage API key (required for Filecoin/IPFS uploads)
# Get yours at: https://files.lighthouse.storage/ → API Key
VITE_LIGHTHOUSE_API_KEY=

# GrimoireRegistry smart contract address (set after deploy)
VITE_GRIMOIRE_CONTRACT_ADDRESS=

# Filecoin Calibration RPC URL
VITE_FILECOIN_CALIBRATION_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# ── Contract deployment (Hardhat) ──
# Private key for deploying contracts (use a test account, never a real one)
PRIVATE_KEY=

# Filecoin Calibration RPC for Hardhat
FILECOIN_CALIBRATION_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
